+def get_dataset_split(name: str, split: str) -> datasets.Dataset:
+    """
+    Load a single dataset split when only one split is required.
+
+    This is especially useful for C4 perplexity evaluation, where loading the
+    train split is unnecessarily expensive.
+    """
+    logging.info(f"Loading dataset split: {name}/{split}")
+
+    properties = _get_dataset_properties(name)
+    load_kwargs = {
+        "path": properties["path"],
+        "name": properties.get("config_name"),
+        "split": split,
+    }
+
+    if "data_files" in properties:
+        if split not in properties["data_files"]:
+            raise KeyError(f"Split {split} is not available for dataset {name}")
+        load_kwargs["data_files"] = {split: properties["data_files"][split]}
+        load_kwargs["verification_mode"] = "no_checks"
+
+    ds = datasets.load_dataset(**load_kwargs)
+
+    if "cols_to_remove" in properties:
+        ds = ds.remove_columns(properties["cols_to_remove"])
+
+    if name == "alpaca":
+        split_ds = get_dataset(name)
+        ds = split_ds[split]
+
+    logging.info("Loading dataset split done")
+    return ds
+
