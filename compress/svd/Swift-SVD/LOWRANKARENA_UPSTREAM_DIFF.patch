+def load_shared_calibration(tokenizer, max_samples, seqlen):
+    """Load LowRankArena's token-identical calibration manifest when set."""
+    path = os.environ.get("LOWRANKARENA_CALIBRATION_FILE", "").strip()
+    if not path:
+        return None
+    payload = torch.load(path, map_location="cpu", weights_only=False)
+    if payload.get("format") != "lowrankarena_shared_calibration_v1":
+        raise ValueError(f"Unsupported shared calibration format in {path}")
+    input_ids = payload["input_ids"]
+    if input_ids.ndim != 2 or input_ids.shape[1] != seqlen:
+        raise ValueError(
+            f"Shared calibration shape {tuple(input_ids.shape)} does not match seqlen={seqlen}"
+        )
+    if input_ids.shape[0] < max_samples:
+        raise ValueError(
+            f"Shared calibration has {input_ids.shape[0]} samples, requested {max_samples}"
+        )
+    recorded_vocab = payload.get("tokenizer_vocab_size")
+    if recorded_vocab is not None and int(recorded_vocab) != int(tokenizer.vocab_size):
+        raise ValueError(
+            f"Shared calibration tokenizer vocab {recorded_vocab} != active vocab {tokenizer.vocab_size}"
+        )
+    selected = input_ids[:max_samples].to(torch.long)
+    print(
+        f"Using shared calibration {path}: dataset={payload.get('dataset')} "
+        f"samples={max_samples} seqlen={seqlen} sha256={payload.get('input_ids_sha256')}"
+    )
+    return [
+        {"input_ids": row.unsqueeze(0), "attention_mask": torch.ones_like(row).unsqueeze(0)}
+        for row in selected
+    ]
+
